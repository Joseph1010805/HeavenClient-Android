<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The client reads its WZ data from shared storage so the same files can
         be dropped on by USB or a file manager, rather than being buried in
         app-private storage. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets the game start the server that lives on this device, for playing
         with no network at all. Termux only honours this once its own
         `allow-external-apps` is set, which nothing outside Termux can write -
         so the permission on its own grants nothing. See LocalServer.java. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Finding games by name on the local network, so nobody types an
         address. Plain mDNS - the mechanism a printer uses to appear in a
         print dialog. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Making a network exist where there is none: Wi-Fi Direct, for a car
         with no router and no hotspot. Android 13 renamed this; below 13 the
         same capability was filed under location, because a list of nearby
         wifi devices says roughly where you are. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Android 11 and up hide other packages unless they are named here.
         Without this the client cannot even tell whether Termux is installed,
         and the offline toggle would have nothing to report. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <!-- Both target devices have physical controls; touch is not required. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="HeavenClient"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".HeavenClientActivity"
            android:label="MapleStory"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Tells Android this activity handles a game controller. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>

</manifest>
